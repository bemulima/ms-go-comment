{
  "name": "@bemulima/ms-comment-client",
  "version": "0.1.0",
  "description": "Framework-agnostic browser SDK for ms-go-comment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
